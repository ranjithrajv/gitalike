{
  "name": "gitalike",
  "version": "0.1.3",
  "private": true,
  "description": "Use any forge, keep your muscle memory. Re-skins GitHub, GitLab and Bitbucket as each other, locally.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "hooks:install": "git config core.hooksPath .githooks",
    "precommit": "node tools/pre-commit.mjs",
    "build": "node build.mjs",
    "build:chromium": "node build.mjs chromium",
    "build:firefox": "node build.mjs firefox",
    "lint": "npm run build:firefox && web-ext lint --source-dir dist/firefox",
    "lint:js": "oxlint --deny-warnings src tools tests build.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "parity": "node tools/compare/parity-score.mjs",
    "parity:write": "node tools/compare/parity-score.mjs --write",
    "parity:judge": "node tools/compare/parity-judge.mjs",
    "style-parity": "node tools/compare/style-parity.mjs",
    "test": "node --test",
    "canary": "node tools/compare/selector-canary.mjs",
    "registry": "node tools/registry.mjs --write",
    "registry:check": "node tools/registry.mjs",
    "plugins": "node tools/registry.mjs --list",
    "new-plugin": "node tools/new-plugin.mjs",
    "package": "npm run package:chromium && npm run package:firefox",
    "package:chromium": "npm run build:chromium && web-ext build --source-dir dist/chromium --artifacts-dir dist/artifacts/chromium --overwrite-dest",
    "package:firefox": "npm run build:firefox && web-ext build --source-dir dist/firefox --artifacts-dir dist/artifacts/firefox --overwrite-dest",
    "publish:chromium": "node tools/publish-chromium.mjs",
    "publish:edge": "node tools/publish-edge.mjs",
    "sign:firefox": "npm run build:firefox && web-ext sign --source-dir dist/firefox --artifacts-dir dist/artifacts/firefox-signed --channel unlisted",
    "screenshots": "node tools/compare/screenshots.mjs store",
    "screenshots:projects": "node tools/compare/screenshots.mjs project",
    "screenshots:profiles": "node tools/compare/screenshots.mjs profile",
    "webp": "node tools/webp.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright-core": "^1.63.0",
    "web-ext": "^10.6.0"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "packageManager": "npm@12.0.2"
}
