{
  "manifest_version": 3,
  "name": "GitAlike — any git platform, preferred UX",
  "short_name": "GitAlike",
  "description": "Use any forge, keep your muscle memory. Re-skins GitHub, GitLab™ and Bitbucket as each other, locally; nothing collected.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "GitAlike",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Toggle the UI swap for the current site"
    },
    "open-other-host": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      },
      "description": "Open this page on the other host"
    }
  }
}
