{
  "apiVersion": 2,
  "skins": [
    {
      "name": "bitbucket",
      "product": "Bitbucket",
      "badge": "BB",
      "color": "#0052cc",
      "layout": "gitlab",
      "description": "The Bitbucket UI, worn by any configured site.",
      "capabilities": [
        "keep",
        "projectTabs",
        "repoOrder"
      ]
    },
    {
      "name": "github",
      "product": "GitHub",
      "badge": "GH",
      "color": "#24292f",
      "layout": "github",
      "description": "The GitHub UI, worn by a GitLab-flavoured site.",
      "capabilities": [
        "hide",
        "keep",
        "projectTabs",
        "repoOrder",
        "shortcutTargets",
        "shortcuts",
        "topbarHide"
      ]
    },
    {
      "name": "gitlab",
      "product": "GitLab",
      "badge": "GL",
      "color": "#7759c2",
      "layout": "gitlab",
      "description": "The GitLab UI, worn by a GitHub- or Gitea-flavoured site.",
      "capabilities": [
        "groups",
        "hide",
        "repoOrder",
        "shortcutTargets",
        "shortcuts",
        "topbarHide"
      ]
    }
  ],
  "sources": [
    {
      "name": "bitbucket",
      "label": "Bitbucket",
      "description": "Bitbucket Cloud’s repository app, mounted in #root.",
      "markup": true,
      "hosts": [
        "bitbucket.org"
      ],
      "compare": {
        "palette": 1,
        "nav": 0.9,
        "page": 1,
        "metadata": 0,
        "profile": 0.5,
        "refs": 1
      },
      "selectors": [
        "app",
        "bootstrap",
        "viewName"
      ],
      "canary": [
        "https://bitbucket.org/tutorials/markdowndemo"
      ],
      "pages": {
        "project": {
          "route": {
            "path": "/<workspace>/<repo>/src",
            "namespace": "workspace"
          },
          "from": "path"
        },
        "profile": {
          "route": {
            "path": "/<workspace>/workspace/repositories/",
            "namespace": "workspace"
          },
          "from": "pathname",
          "equivalent": "workspace"
        },
        "dashboard": {
          "route": "/dashboard",
          "from": null
        },
        "settings": {
          "route": "/account/settings",
          "from": null
        },
        "signIn": {
          "route": "/account/signin",
          "from": null
        },
        "signOut": {
          "route": "/account/signout",
          "from": null
        }
      }
    },
    {
      "name": "gerrit",
      "label": "Gerrit",
      "description": "Gerrit’s PolyGerrit app; recoloured through its root custom properties.",
      "markup": true,
      "hosts": [],
      "compare": {
        "palette": 0.6,
        "nav": 0.8,
        "page": 0,
        "metadata": 0,
        "profile": 0.8,
        "refs": 0.3
      },
      "selectors": [
        "app",
        "body",
        "userHeader"
      ],
      "canary": [
        "https://gerrit-review.googlesource.com/"
      ],
      "pages": {
        "project": {
          "route": {
            "path": "/q/project:",
            "namespace": "project"
          },
          "from": "project:"
        },
        "profile": {
          "route": {
            "path": "/q/owner:",
            "namespace": "owner"
          },
          "from": "owner:",
          "equivalent": "owner-query",
          "selectors": {
            "header": "gr-user-header"
          }
        },
        "dashboard": null,
        "settings": {
          "route": "/settings/",
          "from": null
        },
        "signIn": null,
        "signOut": null
      }
    },
    {
      "name": "gitea",
      "label": "Gitea / Forgejo",
      "description": "Gitea and Forgejo’s shared markup, on gitea.com and Codeberg.",
      "markup": true,
      "hosts": [
        "codeberg.org",
        "gitea.com"
      ],
      "compare": {
        "palette": 1,
        "nav": 1,
        "page": 1,
        "metadata": 0,
        "profile": 0.5,
        "refs": 1
      },
      "selectors": [
        "repoNavList",
        "repoMenu",
        "themeMarker",
        "topBar",
        "repoHeader",
        "pullLink"
      ],
      "canary": [
        "https://codeberg.org/forgejo/forgejo",
        "https://codeberg.org/forgejo/forgejo/pulls",
        "https://gitea.com/gitea/act"
      ],
      "pages": {
        "project": {
          "route": [
            {
              "path": "/<owner>/<repo>",
              "namespace": "user"
            },
            {
              "path": "/<org>/<repo>",
              "namespace": "organization"
            }
          ],
          "from": "path"
        },
        "profile": {
          "route": "/<user>",
          "from": "pathname"
        },
        "dashboard": {
          "route": "/",
          "from": null
        },
        "settings": {
          "route": "/user/settings",
          "from": null
        },
        "signIn": {
          "route": "/user/login",
          "from": null
        },
        "signOut": {
          "route": "/user/logout",
          "from": null
        }
      }
    },
    {
      "name": "github",
      "label": "GitHub — Primer",
      "description": "GitHub’s Primer markup.",
      "markup": true,
      "hosts": [
        "github.com"
      ],
      "compare": {
        "palette": 1,
        "nav": 1,
        "page": 1,
        "metadata": 1,
        "profile": 1,
        "refs": 1
      },
      "selectors": [
        "repoNavList",
        "appHeader",
        "metadataSidebar",
        "metadataPane",
        "profileNav",
        "profileMenu",
        "profileFrame",
        "profileEditable",
        "profileDetail",
        "profileOrg",
        "profileLocation",
        "profileName"
      ],
      "canary": [
        "https://github.com/git/git",
        "https://github.com/torvalds"
      ],
      "pages": {
        "project": {
          "route": [
            {
              "path": "/<owner>/<repo>",
              "namespace": "user"
            },
            {
              "path": "/<org>/<repo>",
              "namespace": "organization"
            }
          ],
          "from": "path"
        },
        "profile": {
          "route": "/<user>",
          "from": "pathname"
        },
        "dashboard": {
          "route": "/dashboard",
          "from": null
        },
        "settings": {
          "route": "/settings",
          "from": null
        },
        "signIn": {
          "route": "/login",
          "from": null
        },
        "signOut": {
          "route": "/logout",
          "from": null
        }
      }
    },
    {
      "name": "gitlab",
      "label": "GitLab — Pajamas",
      "description": "GitLab’s Pajamas markup.",
      "markup": true,
      "hosts": [
        "gitlab.com"
      ],
      "compare": {
        "palette": 1,
        "nav": 1,
        "page": 1,
        "metadata": 1,
        "profile": 1,
        "refs": 1
      },
      "selectors": [
        "superSidebar",
        "navContainer",
        "projectFiles",
        "projectSidebarBlock",
        "projectLayoutSidebar",
        "profileHeader",
        "profileIdentity",
        "profileSidebar",
        "profileName",
        "profileMenu",
        "followersLink",
        "followingLink"
      ],
      "canary": [
        "https://gitlab.com/gitlab-org/gitlab",
        "https://gitlab.com/dzaporozhets"
      ],
      "pages": {
        "project": {
          "route": [
            {
              "path": "/<owner>/<project>",
              "namespace": "user"
            },
            {
              "path": "/<group>/<project>",
              "namespace": "group"
            },
            {
              "path": "/<group>/<subgroup>/<project>",
              "namespace": "subgroup"
            }
          ],
          "from": "path"
        },
        "profile": {
          "route": "/<user>",
          "from": "pathname"
        },
        "dashboard": {
          "route": "/dashboard",
          "from": null
        },
        "settings": {
          "route": "/-/profile",
          "from": null
        },
        "signIn": {
          "route": "/users/sign_in",
          "from": null
        },
        "signOut": {
          "route": "/users/sign_out",
          "from": null
        }
      }
    }
  ]
}
