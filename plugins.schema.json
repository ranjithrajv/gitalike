{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranjithrajv.github.io/gitalike/plugins.schema.json",
  "title": "GitAlike plugin registry",
  "description": "The machine-readable registry `npm run registry` writes to plugins.json, derived from the plugin folders under src/plugins/. Downstream tooling can validate against this; tests/plugins-schema.test.mjs pins the schema to the registry so the two cannot drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "skins", "sources"],
  "properties": {
    "apiVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "The plugin API the registry was built against (GITALIKE_PLUGINS.API_VERSION)."
    },
    "skins": {
      "type": "array",
      "description": "The target UIs a page can be made to look like.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "product",
          "badge",
          "color",
          "layout",
          "description",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "The theme key (gs-theme-<name>) and the storage value."
          },
          "product": { "type": "string", "minLength": 1 },
          "badge": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "layout": { "enum": ["github", "gitlab"] },
          "description": { "type": ["string", "null"] },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "The optional skin capabilities the skin declared."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "The forge markup families a skin can be applied to.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label",
          "description",
          "markup",
          "hosts",
          "compare",
          "selectors",
          "canary"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "markup": {
            "type": "boolean",
            "description": "False for a vocabulary-only source (client-rendered, no DOM hooks)."
          },
          "hosts": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "The bundled hosts that resolve to this source."
          },
          "compare": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "palette",
              "nav",
              "page",
              "metadata",
              "profile",
              "refs"
            ],
            "properties": {
              "palette": { "type": "number", "minimum": 0, "maximum": 1 },
              "nav": { "type": "number", "minimum": 0, "maximum": 1 },
              "page": { "type": "number", "minimum": 0, "maximum": 1 },
              "metadata": { "type": "number", "minimum": 0, "maximum": 1 },
              "profile": { "type": "number", "minimum": 0, "maximum": 1 },
              "refs": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "selectors": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true,
            "description": "The DOM hook names the source declares."
          },
          "canary": {
            "type": "array",
            "items": { "type": "string", "format": "uri" },
            "description": "The live pages the selector canary watches."
          },
          "pages": {
            "type": "object",
            "description": "The page kinds the source declares: route plus how the subject is read from the URL, or null for a kind the forge has none of. Keys are PAGE_KINDS.",
            "additionalProperties": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["route", "from"],
                  "properties": {
                    "route": {
                      "oneOf": [
                        { "$ref": "#/$defs/route" },
                        { "type": "array", "items": { "$ref": "#/$defs/route" }, "minItems": 1 }
                      ],
                      "description": "The path shape(s) that serve this page — a project lives under a user or an organisation/group namespace."
                    },
                    "from": {
                      "type": ["string", "null"],
                      "description": "How the page's subject is read from the URL, or null for a fixed page."
                    },
                    "namespace": {
                      "type": "string",
                      "description": "The owner segment's kind when a page has more than one shape (user, organization, group, subgroup, workspace)."
                    },
                    "equivalent": {
                      "type": "string",
                      "description": "Set when the page is a forge's nearest equivalent of the kind, not the kind itself (Gerrit's owner query, Bitbucket's workspace)."
                    },
                    "selectors": {
                      "type": "object",
                      "description": "DOM hooks the page type is keyed on.",
                      "additionalProperties": { "type": "string" }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "route": {
      "description": "One path shape, with {placeholders} for the segments that vary.",
      "oneOf": [
        { "type": "string", "pattern": "^/" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "namespace": { "type": "string" }
          }
        }
      ]
    }
  }
}
